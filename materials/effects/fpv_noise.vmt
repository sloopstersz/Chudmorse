"UnlitGeneric"
{
    "$basetexture" "effects/fpv_noise"
    "$translucent" 0
    "$vertexcolor" 1
    "$vertexalpha" 1
    "$ignorez" 1
    "$no_fullbright" 1

    "Proxies"
    {
        "AnimatedTexture"
        {
            "animatedtexturevar" "$basetexture"
            "animatedtextureframenumvar" "$frame"
            "animatedtextureframerate" 24
        }
    }
}